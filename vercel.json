{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/sfv-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/sfv-club-master-import",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/recurring-billing",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/billing-inbound-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/task-series-occurrences",
      "schedule": "15 3 * * *"
    }
  ]
}
